{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:avalokita:harmony:context:v1",
  "title": "Selected UTF-8 file context snapshot",
  "type": "object", "additionalProperties": false,
  "required": ["version", "workspace_id", "id", "snapshot_id", "actor", "label", "root_id", "generation", "files", "total_bytes", "manifest_sha256", "created_at", "fresh", "stale_paths", "requires_refresh", "latest_generation", "is_latest", "byte_budget", "scope", "shared_ast"],
  "properties": {
    "version": {"const": "avalokita.harmony/1"}, "workspace_id": {"type": "string"},
    "id": {"type": "string"}, "snapshot_id": {"type": "string"}, "actor": {"type": "string"},
    "label": {"type": "string", "maxLength": 256}, "root_id": {"type": ["string", "null"]},
    "generation": {"type": "integer", "minimum": 1}, "latest_generation": {"type": "integer", "minimum": 1},
    "is_latest": {"type": "boolean"}, "total_bytes": {"type": "integer", "minimum": 0, "maximum": 2097152},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "created_at": {"type": "number"},
    "fresh": {"type": "boolean"}, "requires_refresh": {"type": "boolean"},
    "stale_paths": {"type": "array", "items": {"type": "string"}}, "byte_budget": {"const": 2097152},
    "scope": {"const": "selected_text_files"}, "shared_ast": {"const": false},
    "files": {"type": "array", "minItems": 1, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "canonical_path", "sha256", "bytes", "mtime_ns", "content", "fresh"],
      "properties": {
        "path": {"type": "string"}, "canonical_path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 524288},
        "mtime_ns": {"type": "integer"}, "content": {"type": "string"}, "fresh": {"type": "boolean"}
      }
    }}
  }
}
