 pub fn post_to_claude(sock: &ClaudeSocket, text: &str) -> std::io::Result<()> {
+    post_to_claude_guarded(sock, text, || Ok(()))
+}
+
+/// Avalokita rechecks its exact binding and durable authority after opening/authenticating the socket,
+/// immediately before the first user-frame byte. The ordinary network delivery path is unchanged.
+pub fn post_to_claude_guarded(
+    sock: &ClaudeSocket,
+    text: &str,
+    before_input: impl FnOnce() -> std::io::Result<()>,
+) -> std::io::Result<()> {
     let mut c = open_inbox(&sock.path)?;
     if let Some(t) = &sock.token {
         writeln!(c, "{}", json!({ "type": "auth", "token": t }))?;
     }
+    before_input()?;
     writeln!(c, "{}", json!({ "type": "user", "message": { "role": "user", "content": text } }))?;
     c.flush()
 }
